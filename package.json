{
  "name": "@cocreate/postgresql",
  "version": "1.4.0",
  "description": "Lightweight PostgreSQL CRUD wrapper and multi-tenant state routing client for the CoCreate ecosystem.",
  "keywords": [
    "postgresql",
    "postgres",
    "sql",
    "jsonb",
    "crud-api",
    "abstract-crud",
    "database-abstraction",
    "multi-tenant",
    "multi-tenant-routing",
    "realtime-sync",
    "state-synchronization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreate-app/CoCreate-postgresql.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-postgresql/issues"
  },
  "homepage": "https://cocreate.app/docs/postgresql",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dist": "./dist/postgresql.js",
    "./installer": "./installer/postgresql.installer.js"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.7.0"
  },
  "dependencies": {
    "@cocreate/utils": "^1.50.0",
    "pg": "^8.22.0"
  }
}